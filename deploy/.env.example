# Copie para .env no servidor (chmod 600) e preencha. Nunca versione o .env.

# Perfis: "tunnel" liga o túnel ao Mongo; acrescente "cloudflare" OU "caddy" para o HTTPS (ex.: tunnel,cloudflare).
COMPOSE_PROFILES=tunnel

# URL pública HTTPS da API, com barra no final.
PUBLIC_API_URL=

# Segredos próprios de produção: gere cada um com `openssl rand -base64 48`.
# BUBBLE_SIGNING_KEY é a mesma chave usada pelo workflow do Bubble que assina o token.
BUBBLE_SIGNING_KEY=
STORAGE_LINK_SIGNING_KEY=

RABBITMQ_USER=helpdesk
# Use `openssl rand -hex 32`.
RABBITMQ_PASSWORD=

# MongoDB no .142 através do túnel. A senha precisa estar codificada para URL.
MONGO_CONNECTION_STRING=mongodb://helpdesk_app:SENHA_CODIFICADA@mongo-tunnel:27018/helpdesk_database?authSource=admin&directConnection=true
MONGO_TUNNEL_TARGET=helpdesk-tunnel@192.168.0.142
MONGO_TUNNEL_REMOTE_PORT=27018

# Aviso de resolução por WhatsApp. Ligue só depois do teste: cada resolução envia mensagem real.
OPENWA_ENABLED=false
OPENWA_BASE_URL=
OPENWA_SESSION_ID=
OPENWA_API_KEY=

# Opcional
# API_BIND=0.0.0.0        # somente se um proxy que você já tem precisar alcançar a porta
# API_PORT=5112
# EXTRA_CORS_ORIGIN=      # domínio próprio do app no Bubble, se houver
# CLOUDFLARE_TUNNEL_TOKEN=
# PUBLIC_DOMAIN=
