{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "DatabaseName": "helpdesk_database"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest"
  },
  "BubbleSecurity": {
    "Issuer": "bubble-comprove",
    "Audience": "helpdesk-api",
    "TokenTtlSeconds": 300
  },
  "Cors": {
    "AllowedOrigins": [
      "https://comprover.bubbleapps.io",
      "http://localhost:3000"
    ]
  },
  "Sla": {
    "RulesVersion": "1"
  },
  "Storage": {
    "MaxAttachmentBytes": 26214400,
    "UploadUrlTtlMinutes": 15,
    "PublicBaseUrl": ""
  },
  "Comprove": {
    "BaseUrl": "",
    "FaqSyncEnabled": false
  },
  "OpenWa": {
    "Enabled": false
  }
}
